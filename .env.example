APP_NAME="E-VITRON"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Ganti dengan http://IP-VPS saat pengujian awal, lalu https://subdomain.uinssc.ac.id saat domain & SSL aktif
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evitron_uinssc
DB_USERNAME=evitron_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set ke true segera setelah HTTPS (SSL) aktif di subdomain resmi kampus
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=evitron_

# Reverse proxy yang dipercaya (gunakan 127.0.0.1,::1 untuk VPS + Nginx lokal, atau * hanya di cloud proxy tepercaya)
TRUSTED_PROXIES=127.0.0.1,::1

# Konfigurasi Email Notifikasi (gunakan brevo untuk API HTTPS atau smtp untuk server SMTP kampus/Gmail)
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_TIMEOUT=8
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="evitron@uinssc.ac.id"
MAIL_FROM_NAME="E-VITRON UIN SSC"

# Integrasi SSO Portal Akademik Kampus (Bridge API v2 eCampuz)
BRIDGE_SSO_ENABLED=true
BRIDGE_SSO_BASE_URL=https://bridge.uinssc.ac.id
BRIDGE_SSO_TIMEOUT=8
BRIDGE_SSO_SIMULATE=false

# Saklar Mode Demo Portofolio (WAJIB false pada lingkungan produksi resmi kampus)
DEMO_QUICK_LOGIN=false
# Aktifkan hanya jika ingin menampilkan tombol login cepat demo pada server evaluasi/pameran:
# DEMO_ADMIN_EMAIL=admin.evitron@uinssc.ac.id
# DEMO_ADMIN_PASSWORD=
# DEMO_APPLICANT_IDENTIFIER=2208101001
# DEMO_APPLICANT_EMAIL=2208101001@student.uin.ac.id
# DEMO_APPLICANT_PASSWORD=
